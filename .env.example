BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token
DATABASE_URL=postgresql://budget:budget@localhost:5433/budget_wallet?schema=public
# Comma-separated Telegram user IDs (get yours via @userinfobot)
ALLOWED_TELEGRAM_IDS=123456789,987654321
# IANA time zone for "today" and calendar months
TIMEZONE=Europe/Moscow
# File + console diagnostics (update.in/out, telegram calls). Off unless 1/true/yes.
BUDGET_LOGGING=1
# Optional override; default is /app/logs inside the container
# BUDGET_LOG_DIR=/app/logs
